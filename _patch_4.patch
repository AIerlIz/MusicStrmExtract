Date: Wed, 9 Sep 2026 11:53:07 +0800
Subject: [4/6] 质量：CA1054 Uri 重载、CA2234 HttpTransport GetAsync 改用 Uri、CA1062/CA1031/CA2000/CA1002 抑制\n Uri, CA1062/CA1031/CA2000/CA1002 hardened
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- IHttpTransport.GetAsync 改为 Uri 参数 (CA2234)
- MusicBrainzApi 增加 Uri 构造函数重载 (CA1054)
- HttpClientHandler 启用 CheckCertificateRevocationList (CA5399 已解决)
- CA1062: Plugin/MusicStrmLocalProvider/SearchReleasesAsync 添加 ThrowIfNull
- CA1031: RunRepairInBackground 添加 SuppressMessage
- CA1002: ReleaseGroupScorer/LocalDisc 添加 SuppressMessage
- CA2000: CreateDefaultTransport 添加 SuppressMessage (静态共享 HttpClient)
- 主项目 0 警告 0 错误，测试 129/129 通过
---
 MusicStrmExtract/Online/HttpTransport.cs             |  6 +++---
 MusicStrmExtract/Online/LocalDisc.cs                 |  1 +
 MusicStrmExtract/Online/MusicBrainzApi.cs            | 11 ++++++++++-
 MusicStrmExtract/Online/ReleaseGroupScorer.cs        |  1 +
 MusicStrmExtract/Plugin.cs                           |  1 +
 MusicStrmExtract/Providers/MusicStrmLocalProvider.cs |  2 +-
 tests/MusicStrmExtract.Tests/MusicBrainzApiTests.cs  |  8 ++++----
 7 files changed, 21 insertions(+), 9 deletions(-)

diff --git a/MusicStrmExtract/Online/HttpTransport.cs b/MusicStrmExtract/Online/HttpTransport.cs
index 5f4e5a3..e16535d 100644
--- a/MusicStrmExtract/Online/HttpTransport.cs
+++ b/MusicStrmExtract/Online/HttpTransport.cs
@@ -6,12 +6,12 @@ internal sealed record HttpResponse(int StatusCode, string Body);
 
 internal interface IHttpTransport : IDisposable
 {
-    Task<HttpResponse> GetAsync(string url, CancellationToken ct);
+    Task<HttpResponse> GetAsync(Uri url, CancellationToken ct);
 }
 
 internal sealed class HttpClientTransport(HttpClient http) : IHttpTransport
 {
-    public async Task<HttpResponse> GetAsync(string url, CancellationToken ct)
+    public async Task<HttpResponse> GetAsync(Uri url, CancellationToken ct)
     {
         using var response = await http
             .GetAsync(url, HttpCompletionOption.ResponseHeadersRead, ct)
@@ -24,4 +24,4 @@ internal sealed class HttpClientTransport(HttpClient http) : IHttpTransport
     {
         http.Dispose();
     }
-}
+}
